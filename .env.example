# Leave empty in local dev to use the Vite proxy (see vite.config.ts).
# When running the API with `vercel dev` (port 3000), set:
#   VITE_DEV_API_PROXY=http://localhost:3000
# When calling the API directly instead of the proxy, set:
#   VITE_API_BASE_URL=http://localhost:8443
#
# In production, set VITE_API_BASE_URL to your deployed API origin, e.g.:
#   VITE_API_BASE_URL=https://your-api.vercel.app

VITE_API_BASE_URL=
VITE_DEV_API_PROXY=
